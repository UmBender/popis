{
  "name": "popis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "FC_NUM_RUNS=20000 vitest run .prop.test --testTimeout=300000",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "vim:oracle": "node scripts/vim-oracle.mjs",
    "library:mine": "node scripts/library-mine.mjs",
    "typing:oracle": "node scripts/typing-oracle.mjs",
    "gdb:oracle": "node scripts/gdb-oracle.mjs",
    "stl:oracle": "node scripts/stl-oracle.mjs",
    "compile:oracle": "node scripts/compile-oracle.mjs",
    "wa:oracle": "node scripts/wa-oracle.mjs",
    "shell:oracle": "node scripts/shell-oracle.mjs",
    "regex:oracle": "node scripts/regex-oracle.mjs",
    "ref:oracle": "node scripts/ref-oracle.mjs",
    "contests:fetch": "node scripts/contests-fetch.mjs",
    "build:pages": "vite build --base=/popis/"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
